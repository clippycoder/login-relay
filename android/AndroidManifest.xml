<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.clippycoder.oauthrelay">

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/AppTheme">

        <!--
          Answers "open this web page" for apps on a phone that has no browser, and hands the
          page to a computer connected over adb. It never renders web content itself.
          singleTask: one instance, so one socket server; excludeFromRecents: it is transient.
        -->
        <activity
            android:name=".RelayActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>
    </application>
</manifest>
