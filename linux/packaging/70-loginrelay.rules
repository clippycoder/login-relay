# SPDX-License-Identifier: GPL-3.0-or-later
# Login Relay: lets the logged-in user talk to an Android phone over USB without root, for USB accessory
# mode (no USB debugging needed). TAG+="uaccess" grants access to whoever is at the local seat.
#
# Phones that expose adb (ff4201), PTP/MTP (060101) or vendor-specific MTP (ffff00) get switched to
# accessory mode; a phone already in accessory mode shows up as Google 18d1:2d00..2d05.
# Install:  sudo install -m 644 70-loginrelay.rules /etc/udev/rules.d/
#           sudo udevadm control --reload-rules && sudo udevadm trigger --subsystem-match=usb
ACTION=="remove", GOTO="loginrelay_end"
SUBSYSTEM!="usb", GOTO="loginrelay_end"
ENV{DEVTYPE}!="usb_device", GOTO="loginrelay_end"

ENV{ID_USB_INTERFACES}=="*:ff4201:*", TAG+="uaccess"
ENV{ID_USB_INTERFACES}=="*:060101:*", TAG+="uaccess"
ENV{ID_USB_INTERFACES}=="*:ffff00:*", TAG+="uaccess"
ATTR{idVendor}=="18d1", ATTR{idProduct}=="2d0[0-5]", TAG+="uaccess"

LABEL="loginrelay_end"
