<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LoginRelay</AssemblyName>
    <RootNamespace>LoginRelay.App</RootNamespace>
    <Version>0.5.0</Version>
    <AssemblyTitle>Login Relay</AssemblyTitle>
    <Product>Login Relay</Product>
    <Description>Finishes browser sign-ins for Android phones that have no browser.</Description>
    <ApplicationIcon>..\..\Resources\app.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <!-- One self-contained exe: nothing to install, no .NET runtime needed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoginRelay.Core\LoginRelay.Core.csproj" />
    <!-- Windows' own view of the USB devices (WMI), for the USB driver guide. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- libusb-1.0.dll (x64, LGPL-2.1-or-later, linked dynamically) goes next to LoginRelay.exe. build.ps1 fetches it
         into windows\libs\ first; without it the app still builds, and USB mode says what is missing. -->
    <Content Include="..\..\libs\libusb-1.0.dll" Condition="Exists('..\..\libs\libusb-1.0.dll')" Link="libusb-1.0.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\Resources\app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="..\..\Resources\tray.ico" LogicalName="tray.ico" />
    <EmbeddedResource Include="..\..\Resources\tray-off.ico" LogicalName="tray-off.ico" />
    <EmbeddedResource Include="..\..\Resources\tray-active.ico" LogicalName="tray-active.ico" />
  </ItemGroup>

</Project>
